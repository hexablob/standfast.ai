{
  "name": "@standfast/api",
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "HTTP API. Zod schemas are the single source for the OpenAPI spec.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexablob/standfast.ai.git",
    "directory": "packages/api"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "openapi:generate": "node --run build && node dist/openapi.js > ../../infra/openapi/openapi.json",
    "start": "node dist/serve.js",
    "dev": "node --watch dist/serve.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@hono/zod-openapi": "1.5.1",
    "@standfast/core": "workspace:*",
    "@standfast/db": "workspace:*",
    "hono": "4.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@standfast/cli": "workspace:*",
    "@standfast/sdk": "workspace:*",
    "@types/pg": "8.20.3",
    "pg": "8.22.0",
    "vitest": "4.1.10",
    "@standfast/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
